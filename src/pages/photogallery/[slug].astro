---
import { Col, Row } from "react-bootstrap";
import Layout from "src/layouts/Layout.astro";
import fetchApi from "src/lib/strapi";
import ModalTcm from "../../components/ModalTcm";
import "../../style/photogallery.scss";
// const baseUrl = process?.env?.NE;

export async function getStaticPaths() {
  // 1️⃣ Recupera la lista di pagine disponibili
  const response = await fetchApi({
    endpoint: 'photogalleries?populate[Immagine_anteprima][populate]=*&populate[Img_photogallery][populate]=*&populate=*',  // Il tuo endpoint
    // endpoint: 'photogalleries?populate=*',  // Il tuo endpoint
    wrappedByKey: 'data', // the key to unwrap the response
  });

  // console.log("Risposta API:", response); // 🔍 Verifica la struttura della risposta

    const paths = response?.map((pagina) => ({
      params: { slug: pagina.attributes.Titolo.replace(/\s+/g, '').toLowerCase() },
      props: { 
        titolo: pagina?.attributes?.Titolo,
        data: pagina?.attributes?.Data,
        immagine_anteprima: pagina?.attributes?.Immagine_anteprima,
        img_photogallery: pagina?.attributes?.Img_photogallery,
      },
    })) || [];

  console.log("Paths photogallery:", paths);
  console.log("Paths photogallery response:", response);
  return paths


}

  const {titolo,data, immagine_anteprima, img_photogallery} = Astro.props; // Ottieni lo slug dalla URL
// const myUrl = Astro.url.pathname;
// const myUrl = Astro.url.pathname.at(2);
const myUrl = Astro.url.pathname.split("/").filter(Boolean);
---
<!-- <Debug log={myUrl}></Debug> -->
<Layout title="Welcome to Astro.">
  <div class="page-photogallery-details">
    <h2> {titolo}</h2>
    <Row className="g-4">
      {img_photogallery.map((img) => (
        <Col lg="4">
          <ModalTcm titolo_modale={titolo} pageUrl={myUrl[0]} img_url={img?.Immagine?.data?.attributes?.url} img_seq={img?.Sequenza} img_array={img_photogallery} client:load></ModalTcm>
        </Col>
      ))}
    </Row>
  </div>
</Layout>