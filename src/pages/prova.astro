 <Row className="d-flex justify-content-center ">
    {api_news?.map((news,index) => (
        index === 0 ? 
                <CardTcm 
                    titolo={news?.attributes?.Titolo}
                    data={news?.attributes?.Data}
                    contenuto={news?.attributes?.Corpo_della_pagina}
                    last="true">
                </CardTcm>
                <p>ultima news</p>
              :
                <Col md="4" className="mb-3">
                    <CardTcm titolo={news?.attributes?.Titolo} data={news?.attributes?.Data} contenuto={news?.attributes?.Corpo_della_pagina}></CardTcm>
                </Col>
    ))}
 </Row>


</Layout>