---
import MarkdownRenderer from "@components/MarkdownRenderer";
import Debug from "astro/components/Debug.astro";
import Breadcrumb from "node_modules/astro-bootstrap/lib/components/Breadcrumb";
import Layout from "src/layouts/Layout.astro";
import fetchApi from "src/lib/strapi";
import Campi from "../campi.astro";
import { Col, Row } from "react-bootstrap";
import AccordionReactBootstrap from "@components/AccordionReactBootstrap.jsx";
import { log } from "node_modules/astro/dist/core/logger/core";
interface Pagina{
  attributes:{
    Titolo:string
  }
}
export async function getStaticPaths() {
  // 1️⃣ Recupera la lista di pagine disponibili
  const response = await fetchApi<Pagina[]>({
    endpoint: 'paginas?filters[Visibile][Visibile][$eq]=Si&populate[Documenti][populate]=*&populate[Immagine_apertura_e_anteprima][populate]=*&populate[Campi][populate][Img_campo][populate]=*',
    // endpoint: 'paginas?filters[Visibile][Visibile][$eq]=Si&populate[Documenti][populate]=*&populate[Immagine_apertura_e_anteprima][populate]=*&populate[Campi][populate]=*',
    wrappedByKey: 'data', // the key to unwrap the response
  });

    const paths = response?.map((pagina) => ({
      params: { slug: pagina.attributes.Titolo.replace(/\s+/g, '').toLowerCase() },
      props: { 
        titolo: pagina?.attributes?.Titolo,
        sequenza: pagina?.attributes?.Sequenza,
        corpo_della_pagina: pagina?.attributes?.Corpo_della_pagina,
        documenti: pagina?.attributes?.Documenti?.data,
        visibile: pagina?.attributes?.Visibile,
        immagine_apertura_e_anteprima: pagina?.attributes?.Immagine_apertura_e_anteprima,
        campi: pagina?.attributes?.Campi,
        img_campo: pagina?.attributes?.Campi[1]?.img_campo,
      },
    })) || [];

  console.log("Paths prova:", paths);
  return paths}
  const {titolo, sequenza, corpo_della_pagina, documenti, visibile, immagine_apertura_e_anteprima, campi, img_campo} = Astro.props; // Ottieni lo slug dalla URL

const myUrl = Astro.url.pathname.split("/").filter(Boolean);
