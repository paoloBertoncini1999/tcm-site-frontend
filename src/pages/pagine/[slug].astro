<Layout title="Welcome to Astro.">

  <h2> {titolo}</h2>
    <MarkdownRenderer content={corpo_della_pagina} />
    {documenti?.length!=0 ?
    <div id="div_documenti">
          {documenti?.map((documento) => (
              <a href={documento?.attributes?.url}>
                {documento?.attributes?.name}
              </a>
              <br/>
            ))}  
        </div>
    :
    ""}

    {campi?.length!=0 ?
      <div id="div_campi " >
        <div class="d-flex justify-content-center mb-4">
          <h2 class="">Campi</h2>

        </div>
        <div class="d-flex justify-content-center">
          <Row className="g-4">
            {campi?.map((campo, index) => (
              <>
              <Col md="6" lg="6">

                {/* <Debug log={img} />  */}
              <AccordionReactBootstrap nome_campo={campo?.Nome_campo} pageUrl={myUrl[1]} img_url={campo?.Img_campo[0]?.Immagine?.data?.attributes?.url} img_seq={1} img_array={campo?.Img_campo} client:load/>
              {/* <AccordionReactBootstrap nome_campo={campo?.Nome_campo} pageUrl={myUrl[1]} img_url={campo?.Img_campo[0]?.Immagine?.data?.attributes?.url} img_seq={1} img_array={campo?.Img_campo} client:load/> */}
              </Col>
              </>
            ))}  
        </Row>
        </div>
      </div>
    :
    ""}
</Layout>

